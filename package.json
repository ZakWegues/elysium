{
  "name": "elysium",
  "version": "1.4.0",
  "description": "ELYSIUM — assistente de voz desktop para Windows (Electron + Groq)",
  "author": "Zak",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "check": "tsc --noEmit -p . && vitest run"
  },
  "build": {
    "appId": "com.zak.elysium",
    "productName": "ELYSIUM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ELYSIUM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ELYSIUM"
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^8.2.0",
    "msedge-tts": "^2.0.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/auto-launch": "^5.0.5",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
